# SQLite makes the first local run easy. Use PostgreSQL for deployment/concurrency tests.
DATABASE_URL=sqlite:///./circuit.db
# DATABASE_URL=postgresql+psycopg://circuit:password@127.0.0.1:5432/circuit
APP_ENV=development
APP_VERSION=0.2.0
# Generate for production: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=development-only-secret-change-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
